{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "FitFul Nepal Supplement Product catalog and inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "keyBenefits": { "type": "array" },
        "nutritionalInfo": { "type": "string" },
        "ingredients": { "type": "string" },
        "usage": { "type": "string" },
        "stockStatus": { "type": "string" },
        "stockQuantity": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "status": { "type": "string" },
        "sizes": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "slug", "image", "stockStatus"]
    },
    "Order": {
      "title": "Order",
      "description": "Store customer order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "city": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "discountAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "couponCode": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["customerName", "customerPhone", "shippingAddress", "totalAmount", "orderStatus", "paymentMethod"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact info and purchase history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastOrderDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Homepage dynamic promotional banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "buttonText": { "type": "string" },
        "buttonLink": { "type": "string" },
        "image": { "type": "string" },
        "active": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "image", "active"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category grouping and filter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "displayOrder": { "type": "number" },
        "visible": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "slug", "visible"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and product rating",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "approved": { "type": "boolean" },
        "image": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "customerName", "rating", "comment"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon code for cart checkout",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountType": { "type": "string" },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "active": { "type": "boolean" },
        "expiryDate": { "type": "string" },
        "usageCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store configuration and announcement bar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeName": { "type": "string" },
        "currency": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "announcementBar": { "type": "object" },
        "deliveryCharge": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "codEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeName", "currency", "deliveryCharge"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrative accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Supplements catalog and inventory"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer purchase orders"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Store customer accounts and metrics"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Homepage visual promotional banners"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product category taxonomy"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified customer reviews and ratings"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount codes"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Storewide settings and announcement bar"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin access control and permissions"
    }
  }
}
