{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "FitFul Nepal Supplement Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "keyBenefits": { "type": "array" },
        "nutritionalInfo": { "type": "string" },
        "ingredients": { "type": "string" },
        "usage": { "type": "string" },
        "stockStatus": { "type": "string" },
        "stockQuantity": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "slug", "image", "stockStatus"]
    },
    "User": {
      "title": "User",
      "description": "Application user or administrator profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog and inventory repository"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and administrator privileges"
    }
  }
}
