rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return (
        (isSignedIn() && request.auth.token.email == "young829229@gmail.com") ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (isSignedIn() && request.auth.token.keys().hasAny(['email_verified']) && request.auth.token.email_verified == true)
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true; // Admin management enabled
    }

    // 2. Orders
    match /orders/{orderId} {
      allow create: if true; // Shoppers can place orders
      allow read, update, delete: if true; // Storefront status and admin order management
    }

    // 3. Customers
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // 4. Homepage Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Product Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 6. Customer Reviews
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // 7. Discount Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 8. Store Settings & Announcement Bar
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 9. Admin users
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
