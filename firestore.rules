rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "young829229@gmail.com" ||
        (request.auth.token.keys().hasAny(['email_verified']) && request.auth.token.email_verified == true)
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      // Public read so catalog and product pages can load for all shoppers
      allow read: if true;
      // Admin write access
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
